# Settings for this install. Every docker compose command in this directory reads this file.
# The installer replaces each __NAME__ placeholder. Change values with the config command, which
# restarts the app. Keep a copy of this file somewhere safe: backups do not include it, and
# AUTH_SECRET is needed to keep sessions and tokens valid.

# Image and domain
# The app image, pinned to one version. The update command changes it.
IMAGE=__IMAGE__
# The domain the app is served on, without https://.
DOMAIN=__DOMAIN__
# The contact address Let's Encrypt uses for certificate notices.
ACME_EMAIL=__ACME_EMAIL__

# Database
# bundled runs Postgres in a container next to the app. external uses a Postgres you run.
DB_MODE=__DB_MODE__
# compose.yml:compose.db.yml for the bundled database, compose.yml for an external one.
COMPOSE_FILE=__COMPOSE_FILE__
# The bundled database's password. An external database has no such line.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
# Bundled: postgres://eddy:<POSTGRES_PASSWORD>@db:5432/eddy. External: the URL you gave.
DATABASE_URL=__DATABASE_URL__

# Auth and URLs
# Signs sessions and tokens. Changing it signs everyone out.
AUTH_SECRET=__AUTH_SECRET__
# The public address of the app, for example https://tracker.example.com.
AUTH_URL=__APP_URL__
APP_URL=__APP_URL__
# Opens the first-run setup page, /setup?token=<SETUP_TOKEN>, until the first account exists.
SETUP_TOKEN=__SETUP_TOKEN__

# Sign-in with Google (optional). Set both to turn it on.
# Redirect URI: <APP_URL>/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Sign-in with OpenID Connect (optional), for example Microsoft Entra ID, Okta or Keycloak.
# Set the issuer, ID and secret to turn it on. Redirect URI: <APP_URL>/api/auth/callback/oidc
# For Microsoft use your tenant issuer, https://login.microsoftonline.com/<tenant id>/v2.0.
# AUTH_OIDC_ISSUER=
# AUTH_OIDC_ID=
# AUTH_OIDC_SECRET=
# The button says "Sign in with <name>". Empty means "Single sign-on".
# AUTH_OIDC_NAME=
# true trusts the email when the provider leaves out email_verified. Only for a single-tenant
# Entra ID or an Okta org, where your admins own every account.
# AUTH_OIDC_TRUST_EMAIL=

# Settings bootstrap
# These fill the workspace settings on first start only. After that the settings page owns them.
# The workspace name shown in the app. Empty means the product name.
WORKSPACE_NAME=
# Comma-separated staff email domains. New accounts on these domains become staff.
STAFF_EMAIL_DOMAIN=
# The licence key. Empty means the free edition.
LICENSE_KEY=__LICENSE_KEY__

# Mail
# SMTP server as a URL, for example smtps://user:pass@smtp.example.com:465. Empty means mail is
# logged and staff copy invite and reset links by hand.
SMTP_URL=__SMTP_URL__
# The sender of emails, as a bare address or Name <address>.
MAIL_FROM=__MAIL_FROM__

# Behaviour
# Run pending database migrations when the app starts. false means you run them yourself.
MIGRATE_ON_START=true
# Check once a day for a newer version and tell staff. false turns it off.
UPDATE_CHECK=true

# Backups
# How many backups to keep in backups/.
BACKUP_KEEP=14
# Take a backup every night. The update command always takes one first, whatever this says.
BACKUP_NIGHTLY=true
# A command run after each backup, for example to copy it off the server with rclone.
BACKUP_HOOK=
